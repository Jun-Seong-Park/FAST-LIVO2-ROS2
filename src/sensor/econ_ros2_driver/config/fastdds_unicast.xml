<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
      <transport_descriptor>
          <transport_id>shm_big</transport_id>
          <type>SHM</type>
          <segment_size>67108864</segment_size>
      </transport_descriptor>
      <transport_descriptor>
          <transport_id>udp_unicast</transport_id>
          <type>UDPv4</type>
          <sendBufferSize>2147483647</sendBufferSize>
          <receiveBufferSize>2147483647</receiveBufferSize>
      </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="unicast_peer" is_default_profile="true">
    <rtps>
        <builtin>
            <metatrafficUnicastLocatorList>
                <locator>
                    <udpv4>
                        <address>127.0.0.1</address>
                    </udpv4>
                </locator>
                <locator>
                    <udpv4>
                        <address>100.113.37.42</address>
                    </udpv4>
                </locator>
            </metatrafficUnicastLocatorList>
            <initialPeersList>
                <locator>
                    <udpv4>
                        <address>127.0.0.1</address>
                    </udpv4>
                </locator>
                <locator>
                    <udpv4>
                        <address>100.75.10.92</address>
                    </udpv4>
                </locator>
            </initialPeersList>
        </builtin>
        <defaultUnicastLocatorList>
            <locator>
                <udpv4>
                    <address>127.0.0.1</address>
                </udpv4>
            </locator>
            <locator>
                <udpv4>
                    <address>100.113.37.42</address>
                </udpv4>
            </locator>
        </defaultUnicastLocatorList>    
        <userTransports>
            <transport_id>shm_big</transport_id>
            <transport_id>udp_unicast</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
<!-- Jetson Local-only DDS: custom SHM(64MB) + UDP unicast discovery -->
