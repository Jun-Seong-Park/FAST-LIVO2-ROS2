<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <!-- WiFi LAN UDP: bound to THIS host's LAN IP. Large socket buffers sized for
         the worst-case WUXGA JPEG frame (~0.9 MB) so a frame's ~14 back-to-back
         64 KB datagrams never overflow the kernel socket buffer (best_effort). -->
    <transport_descriptor>
      <transport_id>udp_lan</transport_id>
      <type>UDPv4</type>
      <sendBufferSize>16777216</sendBufferSize>      <!-- 16 MB (send side: this host publishes) -->
      <receiveBufferSize>16777216</receiveBufferSize> <!-- 16 MB -->
      <interfaceWhiteList>
        <address>100.88.16.123</address>             <!-- bind only to WiFi LAN, never tailscale0 -->
      </interfaceWhiteList>
    </transport_descriptor>
    <!-- Same-host SHM: ONLY for local subscribers on the Jetson (e.g. fast_livo2).
         NOT used for Jetson->PC; Fast DDS auto-selects UDP for the remote peer. -->
    <transport_descriptor>
      <transport_id>shm_local</transport_id>
      <type>SHM</type>
      <segment_size>33554432</segment_size>           <!-- 32 MB -->
    </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="lan_peer" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>shm_local</transport_id>
        <transport_id>udp_lan</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <!-- Announce discovery on this host's LAN IP so the PC replies here. -->
        <metatrafficUnicastLocatorList>
          <locator><udpv4><address>100.88.16.123</address></udpv4></locator>
        </metatrafficUnicastLocatorList>
        <!-- Unicast discovery to the PC (no multicast over WiFi). -->
        <initialPeersList>
          <locator><udpv4><address>100.88.16.124</address></udpv4></locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
<!-- Jetson PUBLISHER. self=100.88.16.123  peer(PC)=100.88.16.124  (WiFi LAN, MTU 1500).
     REQUIRES Tailscale DOWN on both ends: LAN 100.88.x is inside Tailscale CGNAT
     100.64.0.0/10, so Tailscale anti-spoof DROPs these packets when it is up. -->
