<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">

  <!-- 대용량 image(SD 640x360x3 = 675KB > default SHM 512KB) overwrite로 인한
       frame drop 방지: SHM segment를 64MB로 명시. default(512KB)는
       useBuiltinTransports=false로 제거하고 아래 custom SHM만 사용. -->
  <transport_descriptors>
      <transport_descriptor>
          <transport_id>shm_big</transport_id>
          <type>SHM</type>
          <segment_size>67108864</segment_size>
      </transport_descriptor>
      <transport_descriptor>
          <transport_id>udp_loopback</transport_id>
          <type>UDPv4</type>
      </transport_descriptor>
  </transport_descriptors>

  <participant profile_name="unicast_peer" is_default_profile="true">
    <rtps>
        <builtin>
            <metatrafficUnicastLocatorList>
                <locator>
                    <udpv4>
                        <address>127.0.0.1</address>
                    </udpv4>
                </locator>
            </metatrafficUnicastLocatorList>
            <initialPeersList>
                <locator>
                    <udpv4>
                        <address>127.0.0.1</address>
                    </udpv4>
                </locator>
            </initialPeersList>
        </builtin>
        <userTransports>
            <transport_id>shm_big</transport_id>
            <transport_id>udp_loopback</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
<!-- Jetson Local-only DDS: custom SHM(64MB) + UDP loopback discovery -->
