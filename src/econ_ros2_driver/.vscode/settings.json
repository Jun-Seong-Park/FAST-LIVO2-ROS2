{
  // cpptools and clangd conflict over IntelliSense (go-to-definition, hover), so
  // disable the cpptools engine and let clangd handle it alone.
  // clangd resolves include paths from build/econ_ros2_driver/compile_commands.json.
  "C_Cpp.intelliSenseEngine": "disabled",
  "clangd.arguments": [
    "--compile-commands-dir=${workspaceFolder}/build/econ_ros2_driver",
    // clang 22's built-in GCC detection assumes gcc-12 (not present on this system) and
    // fails to find libstdc++ headers (csignal/atomic/string not found). Query the actual
    // compiler (g++-11) directly to obtain the correct standard library paths (/usr/include/c++/11 …).
    "--query-driver=/usr/bin/c++,/usr/bin/g++*,/usr/bin/x86_64-linux-gnu-g++*",
    "--background-index",
    "--header-insertion=never"
  ]
}
